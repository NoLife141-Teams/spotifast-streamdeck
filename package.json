{
  "name": "spotifast-streamdeck",
  "version": "0.2.1",
  "private": true,
  "description": "English and French Stream Deck controls for Spotifast on Windows",
  "author": "NoLife141-Teams",
  "engines": {
    "node": ">=20.5.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs && node streamdeck/settings.test.cjs",
    "validate": "streamdeck validate build/rocks.spotifast.streamdeck.sdPlugin",
    "pack": "streamdeck pack build/rocks.spotifast.streamdeck.sdPlugin --output dist"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.2",
    "opentype.js": "2.0.0"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.1",
    "esbuild": "0.28.2"
  }
}
