{
  "name": "spotifast-streamdeck",
  "version": "0.3.0",
  "private": true,
  "description": "English and French Stream Deck controls for Spotifast on Windows",
  "author": "NoLife141-Teams",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "validate": "streamdeck validate build/rocks.spotifast.streamdeck.sdPlugin",
    "pack": "streamdeck pack build/rocks.spotifast.streamdeck.sdPlugin --output dist",
    "release:check": "node scripts/check-release.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "package:verify": "node scripts/verify-package.mjs",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.2",
    "opentype.js": "2.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.2",
    "@zip.js/zip.js": "2.24.0",
    "esbuild": "0.28.2"
  },
  "license": "MIT"
}
