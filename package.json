{
  "name": "spotifast-streamdeck",
  "version": "0.2.5",
  "private": true,
  "description": "English and French Stream Deck controls for Spotifast on Windows",
  "author": "NoLife141-Teams",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "validate": "streamdeck validate build/rocks.spotifast.streamdeck.sdPlugin",
    "pack": "streamdeck pack build/rocks.spotifast.streamdeck.sdPlugin --output dist",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.1",
    "opentype.js": "2.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.1",
    "esbuild": "0.28.2"
  },
  "license": "MIT"
}
